# Names only. Never commit real values. All settings are optional.
# Where the SQLite file lives (default ./data/freight.sqlite; the Docker image uses /data/freight.sqlite)
DATABASE_PATH=
# Optional model for email extraction and draft wording (BYOK). Leave empty to use templates only.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Optional: base URL of an OpenAI-compatible endpoint (self-hosted or proxy). Leave empty for the provider default.
LLM_BASE_URL=
# Any non-empty value except false/0/no/off turns demo mode ON (fails closed): sample data only, no uploads/paste/model, banner shown
DEMO_MODE=
# When set, every page and API route requires HTTP Basic auth (any username, this password)
APP_PASSWORD=
# Comma-separated extra host names the app answers to when it has no APP_PASSWORD (localhost, 127.0.0.1, [::1] always work)
ALLOWED_HOSTS=
